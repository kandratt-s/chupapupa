# Database configuration
AUTH_DATABASE_URL=postgresql+asyncpg://auth_user:auth_pass@postgres:5432/chupapupa_pj
AUTH_SYNC_DATABASE_URL=postgresql://auth_user:auth_pass@postgres:5432/chupapupa_pj
AUTH_SCHEMA_NAME=auth_service

# Application settings
RUN_MIGRATIONS=true
#Вывод SQL-запросов в консоль (для отладки)
DB_ECHO=true

# FastAPI settings
HOST=0.0.0.0
PORT=8000
RELOAD=true