# Event Service Configuration Example

# Основные настройки
DEBUG=False
SERVICE_NAME=event-service
VERSION=1.0.0

# Сетевые настройки
HOST=0.0.0.0
PORT=8004

# База данных (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=chupapupa_pj

# Или полная строка подключения:
# DATABASE_URL=postgresql://user:password@localhost:5432/database
