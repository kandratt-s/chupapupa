# =================================================================
# Пример конфигурации userStatistic микросервиса
# Скопируйте этот файл в .env и заполните свои значения
# =================================================================

# Основные настройки сервиса
SERVICE_NAME=userstatistic-service
HOST=0.0.0.0
PORT=8006
LOG_LEVEL=INFO

# Настройки базы данных
# Для локальной разработки:
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/chupapupa_db

# Компоненты строки подключения к БД (для Docker Compose)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=chupapupa_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# URL-ы других сервисов
ADMIN_SERVICE_URL=http://admin-service:8000
AUTH_SERVICE_URL=http://auth-service:8001
GATEWAY_SERVICE_URL=http://gateway-service:8080

# Настройки безопасности (опционально)
# SECRET_KEY=your-secret-key-here
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=30
