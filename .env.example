# CHUPAPUPA Project Environment Variables
# Скопируйте этот файл в .env и настройте под ваше окружение

# ==============================================
# ОБЩИЕ НАСТРОЙКИ ПРОЕКТА
# ==============================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ==============================================
# БАЗА ДАННЫХ PostgreSQL
# ==============================================
POSTGRES_DB=chupapupa_pj
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgresZXC
DATABASE_URL=postgresql://postgres:postgresZXC@postgres:5432/chupapupa_pj

# ==============================================
# API GATEWAY НАСТРОЙКИ
# ==============================================
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0

# URLs внутренних сервисов (Docker network)
AUTH_SERVICE_URL=http://auth-service:8000
EVENT_SERVICE_URL=http://event-service:8000  
ATTENDANCE_SERVICE_URL=http://attendance-service:8003
USER_STATISTIC_SERVICE_URL=http://user-statistic-service:8000
ADMIN_SERVICE_URL=http://admin-service:8000
BOT_SERVICE_URL=http://bot-service:8000
WEB_SERVICE_URL=http://web-service:8000

# ==============================================
# БЕЗОПАСНОСТЬ И АУТЕНТИФИКАЦИЯ
# ==============================================
# ВАЖНО: Измените этот ключ в продакшене!
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production-2024
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==============================================
# CORS НАСТРОЙКИ
# ==============================================
# Домены, которые могут обращаться к API
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# ==============================================
# ЗАГРУЗКА ФАЙЛОВ И ФОТОГРАФИЙ
# ==============================================
# Максимальный размер файла (в байтах) - 10MB
MAX_FILE_SIZE=10485760
# Разрешенные расширения файлов
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,txt,zip

# Пути к папкам с фотографиями
PHOTOS_BASE_PATH=/shared/photos
FACES_PATH=/shared/photos/faces
ATTENDANCES_PATH=/shared/photos/attendances

# Настройки для userStatistic service (фото пользователей)
# Формат: user_id.расширение (например: user_123.jpg)
USER_PHOTO_FORMAT=user_{user_id}.{extension}

# Настройки для attendance service (файлы посещений) 
# Формат: attendance_id.расширение (например: attendance_456.pdf)
ATTENDANCE_FILE_FORMAT=attendance_{attendance_id}.{extension}

# ==============================================
# TELEGRAM BOT (если используется)
# ==============================================
# Получите токен у @BotFather в Telegram
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook

# ==============================================
# ВНЕШНИЕ ИНТЕРФЕЙСЫ
# ==============================================
# Порт веб-интерфейса
WEB_PORT=3000
# URL Gateway для внутренних сервисов
GATEWAY_URL=http://api-gateway:8000

# ==============================================
# НАСТРОЙКИ ДЛЯ РАЗРАБОТКИ
# ==============================================
# Только для development окружения
RELOAD=false
WORKERS=1

# ==============================================
# PRODUCTION НАСТРОЙКИ
# ==============================================
# Для продакшена рекомендуется:
# - Использовать внешнюю PostgreSQL базу
# - Настроить HTTPS через reverse proxy (nginx)
# - Использовать Docker Secrets для паролей
# - Настроить мониторинг и логирование

# Пример production переменных:
# DATABASE_URL=postgresql://user:password@production-db:5432/chupapupa
# CORS_ORIGINS=https://yourdomain.com
# JWT_SECRET_KEY=very-strong-secret-key-from-secrets-manager
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=WARNING